{
  "name": "beep-design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Beep! — a React Native design system (dark theme, iOS first), documented in a web Storybook.",
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "tokens": "node scripts/build-tokens.ts",
    "chromatic": "chromatic --exit-zero-on-changes"
  },
  "dependencies": {
    "@react-native/assets-registry": "^0.88.1",
    "@react-navigation/native": "^7.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-native": "^0.88.1",
    "react-native-svg": "^15.16.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/react-native-web-vite": "^10.6.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chromatic": "^18.15.0",
    "storybook": "^10.6.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
